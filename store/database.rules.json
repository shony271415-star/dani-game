{
  "rules": {
    "races": {
      ".read": "auth != null && query.orderByChild == 'created' && query.limitToFirst <= 20",
      ".indexOn": ["created"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host/uid').val() == auth.uid) || (data.exists() && !newData.exists() && (data.child('host/uid').val() == auth.uid || data.child('created').val() < now - 86400000)))",
        ".validate": "newData.hasChildren(['v', 'seed', 'diff', 'created', 'host'])",
        "v": { ".validate": "newData.val() == 1" },
        "seed": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000000000000" },
        "diff": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "created": { ".validate": "newData.val() == now" },
        "host": {
          ".validate": "newData.hasChildren(['uid', 'n'])",
          "uid": { ".validate": "newData.val() == auth.uid" },
          "n": { ".validate": "newData.isString() && newData.val().length <= 18" },
          "$o": { ".validate": "(newData.isString() && newData.val().length <= 20) || newData.isNumber() || newData.isBoolean()" }
        },
        "guest": {
          ".write": "auth != null && root.child('races/' + $code + '/host').exists() && (!data.exists() || data.child('uid').val() == auth.uid)",
          ".validate": "newData.hasChildren(['uid', 'n'])",
          "uid": { ".validate": "newData.val() == auth.uid" },
          "n": { ".validate": "newData.isString() && newData.val().length <= 18" },
          "$o": { ".validate": "(newData.isString() && newData.val().length <= 20) || newData.isNumber() || newData.isBoolean()" }
        },
        "go": {
          ".write": "auth != null && !data.exists() && root.child('races/' + $code + '/host/uid').val() == auth.uid && root.child('races/' + $code + '/guest').exists()",
          ".validate": "newData.val() == now"
        },
        "left": {
          "$role": {
            ".write": "auth != null && root.child('races/' + $code + '/' + $role + '/uid').val() == auth.uid",
            ".validate": "($role == 'host' || $role == 'guest') && newData.isBoolean()"
          }
        },
        "p": {
          "$role": {
            ".write": "auth != null && root.child('races/' + $code + '/' + $role + '/uid').val() == auth.uid",
            ".validate": "($role == 'host' || $role == 'guest') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
          }
        },
        "res": {
          "$role": {
            ".write": "auth != null && !data.exists() && root.child('races/' + $code + '/go').exists() && root.child('races/' + $code + '/' + $role + '/uid').val() == auth.uid",
            ".validate": "($role == 'host' || $role == 'guest') && newData.hasChildren(['at', 'sec'])",
            "at": { ".validate": "newData.val() == now" },
            "sec": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "help": { ".validate": "newData.isNumber()" },
            "$o": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
